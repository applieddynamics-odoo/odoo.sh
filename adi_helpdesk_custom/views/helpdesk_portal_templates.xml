<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Helpdesk portal breadcrumb -->
    <template id="adi_helpdesk_portal_breadcrumb"
              inherit_id="helpdesk.portal_my_home_menu_helpdesk">

        <xpath expr="//li[@t-if='ticket'][hasclass('breadcrumb-item')]"
               position="replace">

            <li t-if="ticket"
                class="breadcrumb-item active text-truncate">

                <t t-if="ticket.ticket_ref">
                    [<span t-field="ticket.ticket_ref"/>]
                </t>

                <span t-field="ticket.name"/>

            </li>

        </xpath>

    </template>


    <!-- Helpdesk portal ticket page -->
    <template id="adi_helpdesk_portal_ticket"
              inherit_id="helpdesk.tickets_followup">

        <!-- Change visible ticket heading -->
        <xpath expr="//div[@id='card_header']//div[@class='col-md-9 text-truncate']"
               position="replace">

            <div class="col-md-9 text-truncate">
                <span class="h3">

                    <t t-if="ticket.ticket_ref">
                        [<span t-field="ticket.ticket_ref"/>]
                    </t>

                    <span t-field="ticket.name"/>

                </span>
            </div>

        </xpath>

        <!-- Hide Stage from the customer -->
        <xpath expr="//div[@id='card_header']//div[@class='col col-auto']"
               position="replace"/>

    </template>


    <!-- Remove "Powered by Odoo" from portal pages -->
    <template id="adi_remove_brand_promotion"
              inherit_id="web.frontend_layout">

        <xpath expr="//t[@t-call='web.brand_promotion']"
               position="replace"/>

    </template>

</odoo>