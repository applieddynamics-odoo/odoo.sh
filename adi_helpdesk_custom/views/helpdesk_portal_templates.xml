<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Helpdesk portal breadcrumb -->
    <template id="adi_helpdesk_portal_breadcrumb"
              inherit_id="helpdesk.portal_my_home_menu_helpdesk">

        <xpath expr="//li[@t-if='ticket'][hasclass('breadcrumb-item')]"
               position="replace">

            <li t-if="ticket"
                class="breadcrumb-item active text-truncate">

                <t t-if="ticket.ticket_ref">
                    [<span t-field="ticket.ticket_ref"/>]
                </t>

                <span t-field="ticket.name"/>

            </li>

        </xpath>

    </template>


    <!-- Helpdesk portal ticket page -->
    <template id="adi_helpdesk_portal_ticket"
              inherit_id="helpdesk.tickets_followup">

        <!-- Change visible ticket heading -->
        <xpath expr="//div[@id='card_header']//div[@class='col-md-9 text-truncate']"
               position="replace">

            <div class="col-md-9 text-truncate">
                <span class="h3">

                    <t t-if="ticket.ticket_ref">
                        [<span t-field="ticket.ticket_ref"/>]
                    </t>

                    <span t-field="ticket.name"/>

                </span>
            </div>

        </xpath>

        <!-- Hide Stage from the customer -->
        <xpath expr="//div[@id='card_header']//div[@class='col col-auto']"
               position="replace"/>

        <!-- Customer lead and external ticket recipients -->
        <xpath expr="//div[@t-if='ticket.partner_id']"
               position="replace">

            <div t-if="ticket.partner_id"
                 t-attf-class="col-12 col-md-12 {{ 'mt-3' if ticket.user_id.name else '' }}">

                <!-- Customer Lead -->
                <h6>
                    <small class="text-muted">Customer Lead</small>
                </h6>

                <div class="o_portal_contact_details d-flex flex-column gap-1">
                    <div class="d-flex justify-content-start align-items-center gap-2">
                        <img class="o_avatar o_portal_contact_img rounded"
                             t-att-src="image_data_uri(ticket.partner_id.avatar_128)"
                             alt="Contact"/>
                        <h6 class="mb-0"
                            t-out="ticket.partner_id.name"/>
                    </div>
                </div>

                <!-- Additional external followers -->
                <t t-set="external_followers"
                   t-value="ticket.message_partner_ids.filtered(
                       lambda partner:
                           partner != ticket.partner_id
                           and not partner.user_ids.filtered(
                               lambda user: user.active and not user.share
                           )
                   )"/>

                <div t-if="external_followers"
                     class="mt-3">

                    <h6>
                        <small class="text-muted">
                            Receiving Ticket Updates
                        </small>
                    </h6>

                    <div class="o_portal_contact_details d-flex flex-column gap-1">
                        <t t-foreach="external_followers"
                           t-as="follower">

                            <div class="d-flex justify-content-start align-items-center gap-2">
                                <img class="o_avatar o_portal_contact_img rounded"
                                     t-att-src="image_data_uri(follower.avatar_128)"
                                     alt="Contact"/>
                                <h6 class="mb-0"
                                    t-out="follower.name"/>
                            </div>

                        </t>
                    </div>

                </div>

            </div>

        </xpath>


    </template>


    <!-- Remove "Powered by Odoo" from portal pages -->

    <template id="adi_remove_portal_powered_by"
              inherit_id="portal.portal_record_sidebar">

        <xpath expr="//div[contains(@class, 'text-muted')][contains(., 'Powered by')]"
               position="replace"/>

    </template>

</odoo>