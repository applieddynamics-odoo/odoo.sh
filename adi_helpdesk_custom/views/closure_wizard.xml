<odoo>
    <data>
        <record id="view_adi_helpdesk_close_wizard_form" model="ir.ui.view">
            <field name="name">adi.helpdesk.close.wizard.form</field>
            <field name="model">adi.helpdesk.close.wizard</field>
            <field name="arch" type="xml">
                <form string="Close Ticket">
                    <sheet>
                        <field name="ticket_id" readonly="1"/>

                        <group>
                            <field name="adi_closure_result"/>
                            <field name="adi_closure_statement"/>

                            <div class="mt-3 p-3 border-start border-3 bg-light fst-italic"
                                style="border-color:#008c95 !important; color:#5f6368;">
                                <strong>Note:</strong>
                                Closure information is shared with the customer in the automated closure email,
                                therefore please write a formal closure statement.
                            </div>

                        </group>
                    </sheet>

                    <footer>
                        <button name="action_confirm"
                                string="Close Ticket"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>