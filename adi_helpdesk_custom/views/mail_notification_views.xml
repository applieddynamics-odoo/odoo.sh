<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="adi_mail_notification_layout"
              inherit_id="mail.mail_notification_layout">

        <xpath expr="//span[@id='mail_unfollow']/parent::td/parent::tr"
               position="replace">

            <tr>
                <td align="center"
                    style="min-width: 590px; font-size: 11px; color: #555555;">

                    <span id="mail_unfollow">
                        <a href="/mail/unfollow"
                           style="text-decoration:none; color:#555555;">
                            Unfollow
                        </a>
                    </span>

                </td>
            </tr>

        </xpath>

    </template>

</odoo>