<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adi_helpdesk_enquiry_tree" model="ir.ui.view">
        <field name="name">adi.helpdesk.enquiry.tree</field>
        <field name="model">adi.helpdesk.enquiry</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="name"/>
                <field name="email"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <record id="view_adi_helpdesk_enquiry_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.enquiry.form</field>
        <field name="model">adi.helpdesk.enquiry</field>
        <field name="arch" type="xml">

            <form string="Customer Enquiry">

                <header>

                    <button
                        name="action_open_complete_wizard"
                        type="object"
                        string="Completed"
                        class="btn-primary"
                        invisible="state != 'new'"
                    />

                    <button
                        name="action_block_email"
                        type="object"
                        string="Block Email"
                        class="btn-secondary"
                        invisible="state != 'new'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="new,closed"
                    />

                </header>

                <sheet>

                    <!--
                        User guidance.

                        Uses the standard Odoo information presentation
                        and teal/info icon already familiar elsewhere
                        in the Helpdesk interface.
                    -->
                    <div class="adi_wizard_guidance o_form_full_width"
                        colspan="2"
                        invisible="state != 'new'">

                        <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                        <div>
                            This email was received from a sender who could not be matched
                            to a trusted Helpdesk contact. Please review the information
                            below before taking any further action.
                        </div>

                    </div>

                    <group>
                        <field name="name"/>
                        <field name="email"/>
                    </group>

                    <group string="Message">
                        <field
                            name="message"
                            nolabel="1"
                        />
                    </group>

                    <group invisible="state != 'closed'">
                        <field name="closure_reason"/>
                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <record id="action_adi_helpdesk_enquiry" model="ir.actions.act_window">
        <field name="name">Customer Enquiries</field>
        <field name="res_model">adi.helpdesk.enquiry</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem
        id="menu_adi_helpdesk_enquiry"
        name="Customer Enquiries"
        parent="helpdesk.menu_helpdesk_root"
        action="action_adi_helpdesk_enquiry"
        sequence="20"
    />

</odoo>