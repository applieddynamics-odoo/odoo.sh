<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adi_helpdesk_enquiry_tree" model="ir.ui.view">
        <field name="name">adi.helpdesk.enquiry.tree</field>
        <field name="model">adi.helpdesk.enquiry</field>
        <field name="arch" type="xml">

            <tree create="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="email"/>
                <field name="state"/>
                <field name="closure_reason"/>
                <field name="closed_by_id"/>
                <field name="closed_at"/>
            </tree>

        </field>
    </record>


    <record id="view_adi_helpdesk_enquiry_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.enquiry.form</field>
        <field name="model">adi.helpdesk.enquiry</field>
        <field name="arch" type="xml">

            <form string="Customer Enquiry"
                  create="false">

                <header>

                    <button
                        name="action_open_complete_wizard"
                        type="object"
                        string="Completed"
                        class="btn-primary"
                        invisible="state != 'new'"
                    />

                    <button
                        name="action_block_email"
                        type="object"
                        string="Block Email"
                        class="btn-secondary"
                        invisible="state != 'new'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="new,closed"
                    />

                </header>

                <sheet>

                    <div class="adi_wizard_guidance o_form_full_width"
                         colspan="2"
                         invisible="state != 'new'">

                        <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                        <div>
                            This email was received from a sender who could not
                            be matched to a trusted Helpdesk contact.
                            Please review the information below and either deal
                            with the enquiry manually or block the sender.
                        </div>

                    </div>

                    <group>
                        <field name="name" readonly="1"/>
                        <field name="email" readonly="1"/>
                    </group>

                    <group string="Message">
                        <field
                            name="message"
                            string="Details"
                            readonly="1"
                        />
                    </group>

                    <group
                        string="Closure"
                        invisible="state != 'closed'"
                    >
                        <field name="closure_reason"/>
                        <field name="closed_by_id"/>
                        <field name="closed_at"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <record id="action_adi_helpdesk_enquiry" model="ir.actions.act_window">
        <field name="name">Customer Enquiries</field>
        <field name="res_model">adi.helpdesk.enquiry</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem
        id="menu_adi_helpdesk_enquiry"
        name="Customer Enquiries"
        parent="helpdesk.menu_helpdesk_root"
        action="action_adi_helpdesk_enquiry"
        sequence="20"
    />

</odoo>