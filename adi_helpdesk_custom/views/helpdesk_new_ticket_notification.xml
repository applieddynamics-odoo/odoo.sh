<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_new_ticket_notification"
              name="ADI Helpdesk New Ticket Notification"
              inherit_id="adi_helpdesk_custom.adi_mail_notification_layout_footer"
              primary="True">

        <!-- =====================================================
             EMAIL CONTENT
             ===================================================== -->

        <xpath expr="//div[@t-out='message.body']"
               position="replace">

            <div style="
                font-size: 13px;
                line-height: 1.45;
            ">

                <p style="margin: 0 0 12px 0;">
                    <strong style="font-size: 16px;">

                        <t t-if="
                            message.subject
                            and message.subject.startswith(
                                '&lt;&lt;Lead Assigned&gt;&gt;'
                            )
                        ">
                            LEAD ASSIGNED
                        </t>

                        <t t-else="">
                            NEW TICKET
                        </t>

                    </strong>
                </p>

                <t t-if="
                    message.subject
                    and message.subject.startswith(
                        '&lt;&lt;Lead Assigned&gt;&gt;'
                    )
                ">
                    <p style="margin: 0 0 12px 0;">
                        You have been assigned to lead this ticket.
                    </p>
                </t>

                <table role="presentation"
                       cellspacing="0"
                       cellpadding="0"
                       border="0"
                       style="
                           font-size: 13px;
                           line-height: 1.45;
                       ">

                    <tr>
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Customer:</strong>
                        </td>
                        <td style="padding: 2px 0;">
                            <t t-out="
                                record.adi_notification_company_name
                                or '-'
                            "/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Contact:</strong>
                        </td>
                        <td style="padding: 2px 0;">
                            <t t-out="
                                record.adi_notification_contact_name
                                or '-'
                            "/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 2px 12px 2px 0;">
                            <strong>Ticket Type:</strong>
                        </td>
                        <td style="padding: 2px 0;">
                            <t t-out="
                                record.ticket_type_id.display_name
                                or 'Raw Email Submission'
                            "/>
                        </td>
                    </tr>

                </table>

                <p style="margin: 14px 0 4px 0;">
                    <strong>PROBLEM</strong>
                </p>

                <div t-out="record.description or '-'"/>

            </div>

        </xpath>

    </template>

</odoo>