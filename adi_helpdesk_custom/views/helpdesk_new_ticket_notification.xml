<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_new_ticket_notification"
            name="ADI Helpdesk New Ticket Notification"
            inherit_id="mail.mail_notification_layout"
            primary="True">

        <!-- Remove upper separator -->
        <xpath expr="//td[@t-if='has_button_access']/ancestor::tr[1]/preceding-sibling::tr[1]"
            position="replace"/>

        <!-- Make the access button clearer -->
        <xpath expr="//td[@t-if='has_button_access']/a"
            position="replace">

            <a t-att-href="button_access['url']"
            style="
                font-size: 14px;
                color: #FFFFFF;
                display: block;
                padding: 10px 18px;
                text-decoration: none !important;
                font-weight: 600;
            ">
                View Ticket
            </a>

        </xpath>

        <!-- Remove separator immediately before ticket content -->
        <xpath expr="//div[@t-out='message.body']/preceding::hr[1]"
            position="replace"/>


        <!-- New Ticket email content -->
        <xpath expr="//div[@t-out='message.body']"
            position="replace">

            <div style="font-size: 13px; line-height: 1.45;">

                <p style="margin: 0 0 12px 0;">
                    <strong style="font-size: 16px;">
                        NEW TICKET
                    </strong>
                </p>

                <table role="presentation"
                       cellspacing="0"
                       cellpadding="0"
                       border="0"
                       style="font-size: 13px; line-height: 1.45;">

                    <tr>
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Customer:</strong>
                        </td>
                        <td style="padding: 2px 0;">
                            <t t-out="record.adi_notification_company_name or '-'"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Contact:</strong>
                        </td>
                        <td style="padding: 2px 0;">
                            <t t-out="record.adi_notification_contact_name or '-'"/>
                        </td>
                    </tr>

                    <tr t-if="record.adi_software_version_id">
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Software:</strong>
                        </td>
                        <td style="padding: 2px 0;">
                            <t t-out="record.adi_software_version_id.display_name"/>
                        </td>
                    </tr>

                </table>

                <p style="margin: 14px 0 4px 0;">
                    <strong>PROBLEM</strong>
                </p>

                <div t-out="record.description or '-'"/>

            </div>

        </xpath>

        <xpath expr="//td[@t-if='has_button_access']/a" position="replace">
            <a t-att-href="button_access['url']"
            style="
                font-size: 14px;
                color: #FFFFFF;
                display: block;
                padding: 10px 18px;
                text-decoration: none !important;
                font-weight: 600;
            ">
                View Ticket
            </a>
        </xpath>

    </template>

</odoo>