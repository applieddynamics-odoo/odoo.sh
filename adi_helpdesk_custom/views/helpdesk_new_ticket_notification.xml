<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         ADI Helpdesk - New Ticket Manager Notification

         Used only for the automatic internal New Ticket
         notification sent to Helpdesk followers/managers.

         The underlying chatter message remains empty/minimal.
         Ticket information is rendered here for email only.
         ========================================================= -->

    <template id="adi_helpdesk_new_ticket_notification"
              name="ADI Helpdesk New Ticket Notification"
              inherit_id="mail.mail_notification_layout"
              primary="True">

    <!-- =====================================================
        VIEW TICKET BUTTON

        Fixed width/height is deliberate.
        Desktop Outlook uses the Word rendering engine and
        does not reliably honour padding on email links.
        ===================================================== -->

    <xpath expr="//td[@t-if='has_button_access']"
        position="replace">

        <td t-if="has_button_access">

            <table role="presentation"
                cellspacing="0"
                cellpadding="0"
                border="0">
                <tr>

                    <td width="140"
                        height="40"
                        align="center"
                        valign="middle"
                        bgcolor="#008C95"
                        style="
                            width: 140px;
                            height: 40px;
                            background-color: #008C95;
                            text-align: center;
                            vertical-align: middle;
                        ">

                        <a t-att-href="button_access['url']"
                        style="
                            display: block;
                            width: 140px;
                            line-height: 40px;
                            font-family: Verdana, Arial, sans-serif;
                            font-size: 14px;
                            font-weight: bold;
                            color: #FFFFFF;
                            text-decoration: none;
                        ">
                            View Ticket
                        </a>

                    </td>

                </tr>
            </table>

        </td>

    </xpath>


        <!-- =====================================================
             EMAIL CONTENT

             Replace only the standard mail.message body.

             This deliberately does NOT alter message.body itself,
             so the information below is not duplicated in chatter.
             ===================================================== -->

        <xpath expr="//div[@t-out='message.body']"
               position="replace">

            <div style="
                font-size: 13px;
                line-height: 1.45;
            ">

                <!-- New Ticket heading -->
                <p style="margin: 0 0 12px 0;">
                    <strong style="font-size: 16px;">
                        NEW TICKET
                    </strong>
                </p>


                <!-- Ticket summary -->
                <table role="presentation"
                       cellspacing="0"
                       cellpadding="0"
                       border="0"
                       style="
                           font-size: 13px;
                           line-height: 1.45;
                       ">

                    <!-- Customer -->
                    <tr>
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Customer:</strong>
                        </td>

                        <td style="padding: 2px 0;">
                            <t t-out="record.adi_notification_company_name or '-'"/>
                        </td>
                    </tr>


                    <!-- Contact -->
                    <tr>
                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Contact:</strong>
                        </td>

                        <td style="padding: 2px 0;">
                            <t t-out="record.adi_notification_contact_name or '-'"/>
                        </td>
                    </tr>


                    <!-- Software -->
                    <tr t-if="record.adi_software_version_id">

                        <td style="padding: 2px 14px 2px 0;">
                            <strong>Software:</strong>
                        </td>

                        <td style="padding: 2px 0;">
                            <t t-out="record.adi_software_version_id.display_name"/>
                        </td>

                    </tr>

                </table>


                <!-- Problem statement -->
                <p style="margin: 14px 0 4px 0;">
                    <strong>
                        PROBLEM
                    </strong>
                </p>

                <div t-out="record.description or '-'"/>

            </div>

        </xpath>


    </template>

</odoo>