<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="adi_helpdesk_repair_button_view" model="ir.ui.view">
        <field name="name">adi.helpdesk.repair.button.view</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id"
               ref="helpdesk_repair.helpdesk_ticket_view_form_inherit_stock_user"/>

        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_repair_order_form']"
                   position="attributes">

                <attribute name="string">Raise RMA</attribute>

                <attribute name="invisible">
                    not use_product_repairs or adi_closure_result
                </attribute>

            </xpath>
        </field>
    </record>

</odoo>