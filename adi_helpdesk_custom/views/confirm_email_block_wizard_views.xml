<odoo>
    <record id="adi_helpdesk_confirm_email_block_wizard_view_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.confirm.email.block.wizard.form</field>
        <field name="model">adi.helpdesk.confirm.email.block.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Email Block">
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <strong>This domain is approved.</strong><br/>
                    Are you sure you want to add this email address to the blocked list?
                </div>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>