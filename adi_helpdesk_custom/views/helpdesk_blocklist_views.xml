<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="adi_helpdesk_blocklist_view_tree" model="ir.ui.view">
        <field name="name">adi.helpdesk.blocklist.tree</field>
        <field name="model">adi.helpdesk.blocklist</field>
        <field name="arch" type="xml">
            <tree>
                <field name="value"/>
                <field name="reason"/>
                <field name="create_date" string="Blocked Date"/>
                <field name="create_uid" string="Blocked By"/>
            </tree>
        </field>
    </record>


    <record id="adi_helpdesk_blocklist_view_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.blocklist.form</field>
        <field name="model">adi.helpdesk.blocklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group string="Blocked Sender">
                        <field name="value"/>
                    </group>

                    <group string="Reason">
                        <field name="reason"/>
                    </group>

                    <group string="Audit">
                        <field name="create_date"
                               string="Blocked Date"
                               readonly="1"/>
                        <field name="create_uid"
                               string="Blocked By"
                               readonly="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="adi_helpdesk_blocklist_view_search" model="ir.ui.view">
        <field name="name">adi.helpdesk.blocklist.search</field>
        <field name="model">adi.helpdesk.blocklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="value"/>

                <filter name="blocked_last_14_days"
                        string="Blocked Last 14 Days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_value"
                            string="Email Address"
                            context="{'group_by': 'value'}"/>

                    <filter name="group_by_blocked_date"
                            string="Blocked Date"
                            context="{'group_by': 'create_date:day'}"/>

                    <filter name="group_by_blocked_by"
                            string="Blocked By"
                            context="{'group_by': 'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="adi_helpdesk_blocklist_action"
            model="ir.actions.act_window">
        <field name="name">Blocked Senders</field>
        <field name="res_model">adi.helpdesk.blocklist</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id"
               ref="adi_helpdesk_blocklist_view_search"/>
        <field name="context">
            {'search_default_blocked_last_14_days': 1}
        </field>
    </record>


    <menuitem id="adi_helpdesk_blocklist_menu"
              name="Blocked Senders"
              parent="helpdesk.helpdesk_menu_config"
              action="adi_helpdesk_blocklist_action"
              sequence="80"/>

</odoo>