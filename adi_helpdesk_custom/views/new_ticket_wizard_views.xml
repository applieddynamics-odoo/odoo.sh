<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_adi_helpdesk_new_ticket_wizard_form"
            model="ir.ui.view">

        <field name="name">
            adi.helpdesk.new.ticket.wizard.form
        </field>

        <field name="model">
            adi.helpdesk.new.ticket.wizard
        </field>

        <field name="arch" type="xml">

            <form string="New Ticket">

                <!-- Supporting fields for Partner logic -->
                <field name="is_helpdesk_partner"
                       invisible="1"/>

                <field name="allowed_customer_company_ids"
                       invisible="1"/>

                <group>

                    <group string="Customer">

                        <field name="company_id"/>

                        <field name="contact_id"
                               context="{'adi_show_contact_name_only': True}"
                               options="{
                                   'no_create': True,
                                   'no_create_edit': True
                               }"/>

                        <field name="email"/>

                        <field name="customer_company_id"
                               string="Customer Company"
                               domain="[('id', 'in', allowed_customer_company_ids)]"
                               options="{
                                   'no_create': True,
                                   'no_create_edit': True,
                                   'no_open': True
                               }"
                               invisible="not is_helpdesk_partner"
                               required="is_helpdesk_partner"/>

                    </group>


                    <group string="Ticket Details">

                        <field name="ticket_type_id"
                               widget="selection"
                               options="{
                                   'no_create': True,
                                   'no_create_edit': True,
                                   'no_open': True
                               }"/>

                        <field name="adi_software_version_id"
                               widget="selection"
                               options="{
                                   'no_create': True,
                                   'no_create_edit': True,
                                   'no_open': True
                               }"/>

                        <field name="adi_customer_input_serial_number"/>

                        <field name="adi_customer_reference_number"/>

                    </group>

                </group>


                <group string="Problem">

                    <field name="name"/>

                    <field name="description"/>

                </group>


                <footer>

                    <button name="action_create_ticket"
                            type="object"
                            string="Create Ticket"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <record id="action_adi_helpdesk_new_ticket_wizard"
            model="ir.actions.act_window">

        <field name="name">New Ticket</field>
        <field name="res_model">
            adi.helpdesk.new.ticket.wizard
        </field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

</odoo>