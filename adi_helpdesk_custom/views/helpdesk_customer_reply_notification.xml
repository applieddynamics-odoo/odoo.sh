<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_customer_reply_notification"
              name="ADI Helpdesk Customer Reply Notification"
              inherit_id="adi_helpdesk_custom.adi_mail_notification_layout_footer"
              primary="True">

        <!-- =====================================================
             CUSTOMER REPLY LAYOUT

             Standard Odoo order:
                 Helpdesk controls
                 Message body

             Customer reply order:
                 Message body
                 Separator
                 Helpdesk controls
             ===================================================== -->

        <!-- Move the existing Helpdesk notification controls
             immediately after the existing message body. -->
        <xpath expr="//div[@t-out='message.body']"
               position="after">

            <hr width="100%"
                style="
                    background-color: rgb(204,204,204);
                    border: medium none;
                    clear: both;
                    display: block;
                    font-size: 0;
                    min-height: 1px;
                    line-height: 0;
                    margin: 14px 0;
                "/>

            <xpath expr="//div[@summary='o_mail_notification']"
                   position="move"/>

        </xpath>

    </template>

</odoo>