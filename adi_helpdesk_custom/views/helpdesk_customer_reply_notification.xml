<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_customer_reply_notification"
              name="ADI Helpdesk Customer Reply Notification"
              inherit_id="adi_helpdesk_custom.adi_mail_notification_layout_footer"
              primary="True">

        <!-- =====================================================
             CUSTOMER REPLY CONTENT

             Display the reply before the Helpdesk controls so the
             message itself is the first content the recipient sees.
             ===================================================== -->

        <xpath expr="//td[@t-if='has_button_access']/ancestor::tr[2]"
               position="before">

            <tr>
                <td style="
                    font-family: Verdana, Arial, sans-serif;
                    font-size: 13px;
                    line-height: 1.45;
                    padding: 0;
                ">
                    <div t-out="message.body"/>
                </td>
            </tr>

            <tr>
                <td style="padding: 12px 0 14px 0;">
                    <hr width="100%"
                        style="
                            background-color: rgb(204,204,204);
                            border: medium none;
                            clear: both;
                            display: block;
                            font-size: 0;
                            min-height: 1px;
                            line-height: 0;
                            margin: 0;
                        "/>
                </td>
            </tr>

        </xpath>


        <!--
            The reply is rendered above the View Ticket controls,
            so suppress Odoo's normal body position.
        -->
        <xpath expr="//div[@t-out='message.body']"
               position="replace"/>

    </template>

</odoo>