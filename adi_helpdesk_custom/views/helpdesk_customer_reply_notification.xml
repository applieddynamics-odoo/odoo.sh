<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         ADI Helpdesk - Customer Reply Notification

         Used when a customer-originated message is redistributed
         through an existing Helpdesk ticket.

         The customer's own message remains the content.
         No ADI footer is added.
         ========================================================= -->

    <template id="adi_helpdesk_customer_reply_notification"
              name="ADI Helpdesk Customer Reply Notification"
              inherit_id="mail.mail_notification_layout"
              primary="True">

        <!-- =====================================================
             CUSTOMER REPLY HEADER

             Replace Odoo's complete notification header so the
             message uses the standard ADI Helpdesk presentation
             without duplicate separator lines.

             Fixed button dimensions are deliberate for desktop
             Outlook compatibility.
             ===================================================== -->

        <xpath expr="//div[@summary='o_mail_notification']"
               position="replace">

            <div style="
                padding: 0;
                margin: 0 0 14px 0;
            ">

                <table role="presentation"
                       cellspacing="0"
                       cellpadding="0"
                       border="0">

                    <tr>

                        <td width="140"
                            height="40"
                            align="center"
                            valign="middle"
                            bgcolor="#008C95"
                            style="
                                width: 140px;
                                height: 40px;
                                background-color: #008C95;
                                text-align: center;
                                vertical-align: middle;
                            ">

                            <a t-if="has_button_access"
                               t-att-href="button_access['url']"
                               style="
                                   display: block;
                                   width: 140px;
                                   line-height: 40px;
                                   font-family: Verdana, Arial, sans-serif;
                                   font-size: 14px;
                                   font-weight: bold;
                                   color: #FFFFFF;
                                   text-decoration: none;
                               ">
                                View Ticket
                            </a>

                        </td>

                    </tr>

                </table>

                <hr width="100%"
                    style="
                        background-color: rgb(204,204,204);
                        border: medium none;
                        clear: both;
                        display: block;
                        font-size: 0;
                        min-height: 1px;
                        line-height: 0;
                        margin: 12px 0 14px 0;
                    "/>

            </div>

        </xpath>


        <!-- =====================================================
             CUSTOMER REPLY CONTENT

             No Customer / Contact / Ticket Type summary.

             The purpose is simply to make the incoming response
             quick to identify and read.
             ===================================================== -->

        <xpath expr="//div[@t-out='message.body']"
               position="replace">

            <div style="
                font-size: 13px;
                line-height: 1.45;
            ">

                <p style="margin: 0 0 12px 0;">
                    <strong style="font-size: 16px;">
                        CUSTOMER REPLIED
                    </strong>
                </p>

                <div t-out="message.body"/>

            </div>

        </xpath>


        <!-- =====================================================
             END OF CUSTOMER MESSAGE

             One separator only.

             No ADI/company footer is shown because the message
             itself was written by the customer.
             ===================================================== -->

        <xpath expr="//b[@t-out='company.name']/parent::div"
               position="replace">

            <div style="margin-top: 24px;">

                <hr width="100%"
                    style="
                        background-color: rgb(204,204,204);
                        border: medium none;
                        clear: both;
                        display: block;
                        font-size: 0;
                        min-height: 1px;
                        line-height: 0;
                        margin: 16px 0 4px 0;
                    "/>

            </div>

        </xpath>

    </template>

</odoo>