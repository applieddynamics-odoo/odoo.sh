<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_customer_reply_notification"
              name="ADI Helpdesk Customer Reply Notification"
              inherit_id="adi_helpdesk_custom.adi_mail_notification_layout_footer"
              primary="True">

        <!-- =====================================================
             CUSTOMER REPLY CONTENT

             Put the actual reply first so the recipient sees the
             message before the Helpdesk navigation controls.
             ===================================================== -->

        <xpath expr="//div[@summary='o_mail_notification']"
               position="before">

            <div style="
                font-size: 13px;
                line-height: 1.45;
                margin: 0 0 14px 0;
            ">
                <div t-out="message.body"/>
            </div>

            <hr width="100%"
                style="
                    background-color: rgb(204,204,204);
                    border: medium none;
                    clear: both;
                    display: block;
                    font-size: 0;
                    min-height: 1px;
                    line-height: 0;
                    margin: 12px 0 14px 0;
                "/>

        </xpath>


        <!--
            The body has already been rendered above the Helpdesk
            header, so remove Odoo's normal body position.
        -->
        <xpath expr="//div[@t-out='message.body']"
               position="replace"/>


        <!--
            For customer replies the warning is the final element,
            so remove the shared separator that normally appears
            underneath the warning.
        -->
        <xpath expr="//td[@t-if='has_button_access']/ancestor::tr[2]/following-sibling::tr[1]/td/hr"
               position="replace"/>

    </template>

</odoo>