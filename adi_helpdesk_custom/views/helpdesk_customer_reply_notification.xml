<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_customer_reply_notification"
              name="ADI Helpdesk Customer Reply Notification"
              inherit_id="adi_helpdesk_custom.adi_mail_notification_layout_footer"
              primary="True">

        <!-- =====================================================
             CUSTOMER REPLY LAYOUT

             Reply first, then a single separator, then
             the Helpdesk controls.
             ===================================================== -->

        <!-- Make the actual reply visually dominant -->
        <xpath expr="//div[@t-out='message.body']"
               position="attributes">

            <attribute name="style">
                font-family: Verdana, Arial, sans-serif;
                font-size: 15px;
                line-height: 1.5;
                margin: 0 0 18px 0;
            </attribute>

        </xpath>


        <!-- Move the Helpdesk controls below the reply and
             place one separator immediately above them. -->
        <xpath expr="//div[@t-out='message.body']"
               position="after">

            <hr width="100%"
                style="
                    background-color: rgb(204,204,204);
                    border: medium none;
                    clear: both;
                    display: block;
                    font-size: 0;
                    min-height: 1px;
                    line-height: 0;
                    margin: 0 0 16px 0;
                "/>

            <xpath expr="//div[@summary='o_mail_notification']"
                   position="move"/>

        </xpath>


        <!-- Remove the shared separator below the warning -->
        <xpath expr="//td[@t-if='has_button_access']/ancestor::tr[2]/following-sibling::tr[1]/td/hr"
               position="replace"/>

    </template>

</odoo>