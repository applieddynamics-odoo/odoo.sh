<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="adi_helpdesk_customer_reply_notification"
              name="ADI Helpdesk Customer Reply Notification"
              inherit_id="adi_helpdesk_custom.adi_mail_notification_layout_footer"
              primary="True">

        <!-- Make the reply visually dominant -->
        <xpath expr="//div[@t-out='message.body']"
               position="attributes">

            <attribute name="style">
                font-family: Verdana, Arial, sans-serif;
                font-size: 15px;
                line-height: 1.5;
                margin: 0 0 18px 0;
            </attribute>

        </xpath>


        <!-- Move the Helpdesk controls below the reply -->
        <xpath expr="//div[@t-out='message.body']"
               position="after">

            <div style="
                border-top: 1px solid #cccccc;
                padding-top: 16px;
                margin-top: 2px;
            ">

                <xpath expr="//div[@summary='o_mail_notification']"
                       position="move"/>

            </div>

        </xpath>


        <!-- Remove the inherited separator below the warning -->
        <xpath expr="//td[@t-if='has_button_access']/ancestor::tr[2]/following-sibling::tr[1]/td/hr"
               position="replace"/>

    </template>

</odoo>