<odoo>
    <record id="adi_helpdesk_software_version_view_tree" model="ir.ui.view">
        <field name="name">adi.helpdesk.software.version.tree</field>
        <field name="model">adi.helpdesk.software.version</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="adi_helpdesk_software_version_view_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.software.version.form</field>
        <field name="model">adi.helpdesk.software.version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="adi_helpdesk_software_version_action" model="ir.actions.act_window">
        <field name="name">Software Versions</field>
        <field name="res_model">adi.helpdesk.software.version</field>
        <field name="view_mode">tree,form</field>
    </record>


<menuitem id="adi_helpdesk_software_version_menu"
          name="Software Versions"
          parent="helpdesk.helpdesk_menu_config"
          action="adi_helpdesk_software_version_action"
          sequence="50"/>

</odoo>