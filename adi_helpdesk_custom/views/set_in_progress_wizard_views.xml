<odoo>
    <record id="adi_helpdesk_set_in_progress_wizard_view_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.set.in.progress.wizard.form</field>
        <field name="model">adi.helpdesk.set.in.progress.wizard</field>
        <field name="arch" type="xml">
            <form string="Set to In Process">

                <field name="adi_new_contact_review_required" invisible="1"/>
                <field name="adi_company_domain" invisible="1"/>
                <field name="adi_domain_status" invisible="1"/>
                <field name="adi_charge_to_order_domain" invisible="1"/>
                <field name="ticket_id" invisible="1"/>

                <div class="o_form_full_width mb-3"
                    invisible="not adi_new_contact_review_required">
                    <div class="alert alert-info mb-0">
                        <i class="fa fa-envelope me-2"/>
                        <strong>Email check required</strong><br/>
                        Check the submitted email address first. Correct any typo. If it matches an existing contact, use that contact. If it is a genuine new contact at the approved company, complete the name and company before continuing.
                    </div>
                </div>

                <group string="Contact Review"
                    invisible="not adi_new_contact_review_required">

                    <field name="contact_email"/>

                    <field name="matched_contact_id" readonly="1"/>

                    <field name="company_id"
                        options="{'no_create': True, 'no_open': True, 'search_more': False}"
                        domain="adi_company_domain"
                        invisible="matched_contact_id"/>

                    <field name="contact_name"
                        invisible="matched_contact_id"/>

                    <field name="create_contact"
                        invisible="matched_contact_id"/>

                </group>

            <!-- =====================================================
                 Main Set In Progress workflow
                 ===================================================== -->

            <group
                invisible="adi_new_contact_review_required and not matched_contact_id"
                col="1"
                class="o_form_full_width adi_set_in_progress_compact">

                <!-- =================================================
                    TOP ROW
                    Assignment | Priority
                    ================================================= -->
                <group col="2" class="o_form_full_width adi_wizard_top_row">

                    <!-- Assignment - left column -->
                    <group string="Assignment">

                        <field name="user_id"
                            string="Lead"
                            class="adi_wizard_select"
                            options="{'no_create': True}"/>

                        <field name="adi_interested_user_ids"
                            string="Followers"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_open': True}"/>

                        <div class="adi_wizard_guidance o_form_full_width"
                            colspan="2">

                            <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                            <div>
                                Select the person responsible for leading the investigation.
                                Add any other internal people who need to follow the ticket.
                            </div>

                        </div>

                    </group>


                    <!-- Priority - right column -->
                    <group string="Priority">

                        <field name="adi_severity"
                            string="Severity"
                            class="adi_wizard_select"/>

                        <div class="adi_wizard_guidance o_form_full_width"
                            colspan="2">

                            <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                            <div>
                                Assign a severity level based on the criteria below so that all customers are treated equally.<br/>
                                <strong>High:</strong> Critical issue preventing operation or testing.<br/>
                                <strong>Medium:</strong> Normal operational issue affecting workflow.<br/>
                                <strong>Low:</strong> Minor issue or cosmetic problem.
                            </div>

                        </div>

                    </group>

                </group>


                    <!-- =================================================
                        CHARGE ALLOCATION
                        Where should the work be charged?
                        ================================================= -->
                    <group string="Charge Allocation"
                        col="2"
                        class="o_form_full_width">

                        <div class="adi_wizard_guidance o_form_full_width"
                            colspan="2">

                            <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                            <div>
                                <strong>Tickets should be charged to:</strong><br/>
                                • A support contract. If a replacement contract is imminent, book the ticket to the previous year's contract, which remains open.<br/>
                                • An in-progress or warranty-stage Sales Order.<br/>
                                • Expense account 78000 - Customer Support (non-contract), where no contract exists but ADI has agreed to support the customer at our expense.
                            </div>

                        </div>

                        <field name="adi_charge_to_order_id"
                            string="Charge to"
                            domain="adi_charge_to_order_domain"
                            context="{'adi_helpdesk_charge_to': True}"
                            options="{'no_create': True, 'no_open': True}"
                            invisible="adi_non_contract"/>

                        <field name="adi_non_contract"
                            string="No Contract"
                            invisible="adi_charge_to_order_id"/>

                        <div class="adi_wizard_guidance o_form_full_width"
                            colspan="2"
                            invisible="adi_charge_to_order_id or not adi_non_contract">

                            <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                            <div>
                                Expense to 78000 - Customer Support (non-contract)
                            </div>

                        </div>

                        <field name="adi_contract_date_range"
                            string="Cover Period"
                            readonly="1"
                            force_save="1"
                            invisible="not adi_charge_to_order_id"/>

                        <field name="adi_contract_status"
                            readonly="1"
                            force_save="1"
                            invisible="not adi_charge_to_order_id"
                            decoration-success="adi_contract_status == 'active'"
                            decoration-warning="adi_contract_status == 'warning'"
                            decoration-danger="adi_contract_status == 'expired'"/>

                    </group>

                </group>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button name="action_block_sender"
                            type="object"
                            string="Block Sender"
                            class="btn-secondary"
                            invisible="not adi_new_contact_review_required or matched_contact_id"
                            confirm="This will block this email address and archive the ticket. Continue?"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>