<odoo>
    <record id="adi_helpdesk_ticket_form_view" model="ir.ui.view">
        <field name="name">adi.helpdesk.ticket.form.view</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">

            <!-- =========================================================
                 Header workflow buttons
                 ========================================================= -->
            <xpath expr="//form/header" position="inside">
                <button name="action_adi_open_review_validity_wizard"
                        type="object"
                        string="Review Validity"
                        class="btn-primary"
                        invisible="not adi_validity_check_required"/>

                <button name="action_adi_open_set_in_progress_wizard"
                        type="object"
                        string="Set In Process"
                        class="btn-primary"
                        invisible="not adi_show_set_in_progress_button"/>

                <button name="action_adi_send_back_to_validity_check"
                        type="object"
                        string="Repeat Validity Check"
                        class="btn-secondary"
                        invisible="not adi_can_repeat_validity"/>
                <button name="action_adi_open_close_wizard"
                        type="object"
                        string="Close Ticket"
                        class="btn-primary"
                        invisible="not adi_show_close_button"/>

            </xpath>

            <!-- Hide the standard large title. The breadcrumb/control panel carries the ticket reference. -->
            <xpath expr="//h1" position="replace">
                <h1 class="d-none">
                    <field name="name"/>
                </h1>
            </xpath>

            <!-- =========================================================
                 Technical / modifier support fields
                 These fields must be present in the view because buttons,
                 cards, or inherited Odoo widgets use them in modifiers.
                 ========================================================= -->
            <xpath expr="//field[@name='kanban_state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='kanban_state']" position="after">
                <field name="team_id" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="use_sla" invisible="1"/>
                <field name="sla_deadline" invisible="1"/>
                <field name="adi_show_set_in_progress_button" invisible="1"/>
                <field name="adi_show_close_button" invisible="1"/>
                <field name="adi_validity_check_required" invisible="1"/>
                <field name="adi_new_contact_review_required" invisible="1"/>
                <field name="adi_can_repeat_validity" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- =========================================================
                 Main Helpdesk layout
                 Replaces the standard sheet group with compact ADI cards.
                 ========================================================= -->
            <xpath expr="//sheet/group" position="replace">

                <!-- Workflow warning cards -->
                <div class="row mb-3">
                    <div class="col-12" invisible="not adi_validity_check_required">
                        <div class="adi_helpdesk_warning_card">
                            <strong>Validity Check Required</strong>
                            <div>Please press "Review Validity" to confirm or reject the email contact.</div>
                        </div>
                    </div>

                    <div class="col-12" invisible="not adi_new_contact_review_required">
                        <div class="adi_helpdesk_warning_card">
                            <strong>New Contact Review Required</strong>
                            <div>This email is from a known domain. Please use "Set In Process" to confirm contact and ticket details before progressing.</div>
                        </div>
                    </div>
                </div>

                <!-- =====================================================
                     Input card
                     Customer identity, submitted details, subject, and problem.
                     Header uses the shared adi_card_header pattern.
                     ===================================================== -->
                <div class="adi_helpdesk_card adi_subject_card">

                    <div class="adi_card_header">
                        <span class="adi_card_title">Input</span>

                        <div class="adi_card_items">

                            <span class="adi_card_item">
                                <i class="fa fa-building adi_summary_icon"/>
                                <field name="adi_matched_company_id"
                                       readonly="1"
                                       nolabel="1"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-user adi_summary_icon"/>
                                <field name="adi_customer_contact_name"
                                       readonly="1"
                                       nolabel="1"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-envelope adi_summary_icon"/>
                                <field name="partner_email"
                                       readonly="1"
                                       nolabel="1"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-wrench adi_summary_icon"/>
                                <field name="ticket_type_id"
                                       widget="selection"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-code-fork adi_summary_icon"/>
                                <field name="adi_software_version_id"
                                       widget="selection"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-tag adi_summary_icon"/>
                                <span class="fw-bold">Asset where found:</span>
                                <field name="adi_customer_input_serial_number"
                                       nolabel="1" readonly="1"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-address-card adi_summary_icon"/>
                                <span class="fw-bold">Cust Ref:</span>
                                <field name="adi_customer_reference_number"
                                       nolabel="1"/>
                            </span>

                        </div>
                    </div>

                    <hr/>

                    <div class="adi_ticket_summary_row">
                        <span class="adi_ticket_summary_label">Subject:</span>
                        <span class="adi_ticket_summary_value">
                            <field name="name" readonly="1" nolabel="1"/>
                        </span>
                    </div>

                    <div class="adi_ticket_summary_row">
                        <div class="adi_problem_label_column">
                            <span class="adi_ticket_summary_label">Problem:</span>
                            <a href="#"
                               class="adi_problem_toggle"
                               title="Expand">
                                <i class="fa fa-plus-square"/>
                            </a>
                        </div>

                        <div class="adi_ticket_summary_value adi_problem_inline">
                            <field name="description" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                </div>

                <!-- =====================================================
                     Status / Ticket Management card
                     Operational fields used once the ticket is accepted.
                     Header uses the shared adi_card_header pattern.
                     ===================================================== -->
                <div class="adi_helpdesk_card adi_management_card">

                    <div class="adi_card_header">
                        <span class="adi_card_title">Status</span>

                        <div class="adi_card_items">

                            <span class="adi_card_item">
                                <i class="fa fa-calendar adi_summary_icon"/>
                                <span class="fw-bold">Created:</span>
                                <field name="adi_create_date_only"
                                       readonly="1"
                                       nolabel="1"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-exclamation-circle adi_summary_icon"/>
                                <span class="fw-bold">Severity:</span>
                                <field name="adi_severity" nolabel="1"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-tag adi_summary_icon"/>
                                <span class="fw-bold">Asset:</span>
                                <field name="adi_test_asset_id"
                                       nolabel="1"/>
                            </span>

                            <span class="adi_card_item">
                                <i class="fa fa-user adi_summary_icon"/>
                                <span class="fw-bold">Assigned:</span>
                                <field name="user_id"
                                       nolabel="1"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </span>

                        </div>
                    </div>

                    <hr/>

                    <div class="adi_management_grid">

                        <!-- Standard Odoo SLA widget moved into the ADI card. -->
                        <span class="adi_management_kpi adi_management_sla"
                              invisible="not sla_status_ids"
                              groups="helpdesk.group_use_sla">

                            <field name="sla_status_ids"
                                   widget="helpdesk_sla_many2many_tags"
                                   invisible="not use_sla"
                                   options="{'color_field': 'color', 'no_edit_color': True}"
                                   class="mb-0"
                                   readonly="1"
                                   groups="helpdesk.group_use_sla"/>

                            <span invisible="not sla_deadline or not use_sla"
                                  groups="helpdesk.group_use_sla"
                                  class="text-muted d-inline-flex align-items-center">

                                <i class="fa fa-clock-o me-1"
                                   aria-label="Sla Deadline"
                                   title="Sla Deadline"/>

                                <field name="sla_deadline"
                                       class="mb-0"
                                       widget="remaining_days"/>
                            </span>
                        </span>

                        <div>
                            <span class="adi_management_label">ADI SPR Number</span>
                            <field name="adi_spr_number"/>
                        </div>

                        <div>
                            <span class="adi_management_label">SIR Hardware Part Numbers</span>
                            <field name="adi_sir_hardware_part_number_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>

                        <div>
                            <span class="adi_management_label">Sales or Maintenance Order</span>
                            <field name="adi_customer_input_sales_or_maintenance_order"/>
                        </div>

                    </div>

                    <hr/>

                    <div invisible="stage_id.name != 'Closed'">
                        <hr/>
                        <div class="adi_management_notes_row">
                            <div class="adi_management_notes_label">
                                Closure
                            </div>
                            <div>
                                <strong>Result:</strong>
                                <field name="adi_closure_result" readonly="1" nolabel="1"/>
                                <br/>
                                <strong>Statement:</strong>
                                <field name="adi_closure_statement" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="adi_management_notes_row">
                        <div class="adi_management_notes_label">
                            Internal Notes
                            <a href="#"
                               class="adi_management_notes_toggle"
                               title="Expand">
                                <i class="fa fa-plus-square"/>
                            </a>
                        </div>

                        <div class="adi_management_notes_inline">
                            <field name="adi_internal_notes"
                                   nolabel="1"/>
                        </div>

                        <div invisible="stage_id.name != 'Closed'">
                            <separator string="Closure"/>

                            <field name="adi_closure_result" readonly="1"/>
                            <field name="adi_closure_statement" readonly="1"/>
                            <field name="close_date" readonly="1"/>
                        </div>

                    </div>

                </div>

            </xpath>

            <!-- =========================================================
                Developer / exploration tabs
                ========================================================= -->
            <xpath expr="//notebook" position="replace">
                <notebook>

                    <!-- Temporary metrics / bridge exploration tab -->
                    <page string="Metrics" groups="base.group_no_one">

                        <div class="alert alert-info">
                            <strong>Temporary metrics / Repair bridge exploration</strong><br/>
                            This tab exposes core Helpdesk fields so we can review what is already available
                            before building the Repair integration.
                        </div>

                        <group string="Assignment / Timing">
                            <field name="assign_date" readonly="1"/>
                            <field name="assign_hours" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="date_last_stage_update" readonly="1"/>
                            <field name="close_date" readonly="1"/>
                            <field name="close_hours" readonly="1"/>
                            <field name="open_hours" readonly="1"/>
                        </group>

                        <group string="Response Metrics">
                            <field name="first_response_hours" readonly="1"/>
                            <field name="avg_response_hours" readonly="1"/>
                            <field name="total_response_hours" readonly="1"/>
                            <field name="oldest_unanswered_customer_message_date" readonly="1"/>
                        </group>

                        <group string="Tracking">
                            <field name="duration_tracking" readonly="1"/>
                        </group>

                    </page>

                    <!-- Developer-only correction tab -->
                    <page string="Debug and Corrections" groups="base.group_no_one">

                        <div class="alert alert-warning">
                            <strong>Admin correction area</strong><br/>
                            These fields are normally controlled by the ADI Helpdesk validation workflow.
                            Only amend them manually if a ticket has bypassed or failed the normal checks.
                        </div>

                        <group string="Submitted / Raw Customer Data">
                            <field name="adi_submitted_email" readonly="1"/>
                            <field name="adi_submitted_contact_name" readonly="1"/>
                            <field name="adi_submitted_company_name" readonly="1"/>
                        </group>

                        <group string="Validated Contact Links">
                            <field name="partner_id" readonly="0"/>
                            <field name="partner_email" readonly="0"/>
                            <field name="partner_name" readonly="0"/>
                            <field name="adi_matched_company_id" readonly="0"/>
                        </group>

                        <group string="Validation Flags">
                            <field name="adi_validity_check_required" readonly="0"/>
                            <field name="adi_new_contact_review_required" readonly="0"/>
                            <field name="adi_can_repeat_validity" readonly="0"/>
                        </group>

                        <group string="Workflow / Timing">
                            <field name="stage_id" readonly="0"/>
                            <field name="create_date"/>
                            <field name="adi_create_date_only"/>
                            <field name="adi_stage_entered_date" readonly="0"/>
                            <field name="close_date"/>
                        </group>

                        <group string="Contract / Asset Data">
                            <field name="adi_contract_date_range" readonly="0"/>
                            <field name="adi_contract_status" readonly="0"/>
                        </group>

                    </page>

                </notebook>
            </xpath>

        </field>
    </record>

</odoo>
