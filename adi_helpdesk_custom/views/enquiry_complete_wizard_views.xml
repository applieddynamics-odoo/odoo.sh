<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adi_helpdesk_enquiry_complete_wizard_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.enquiry.complete.wizard.form</field>
        <field name="model">adi.helpdesk.enquiry.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete Customer Enquiry">

                <field name="enquiry_id" invisible="1"/>

                <div class="adi_wizard_guidance o_form_full_width"
                    colspan="2">

                    <i class="fa fa-info-circle adi_wizard_guidance_icon"/>

                    <div>
                        <strong>Please confirm before closing this enquiry.</strong><br/>
                        Where applicable, please confirm that you have added the sender
                        as a trusted Contact and manually created the required Helpdesk ticket.<br/><br/>
                        If no Helpdesk ticket is required, confirm that the enquiry has
                        otherwise been dealt with before closing it.
                    </div>

                </div>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Completed"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>