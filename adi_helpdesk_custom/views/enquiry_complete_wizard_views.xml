<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="view_adi_helpdesk_enquiry_complete_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">
            adi.helpdesk.enquiry.complete.wizard.form
        </field>

        <field name="model">
            adi.helpdesk.enquiry.complete.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Complete Customer Enquiry">

                <field
                    name="enquiry_id"
                    invisible="1"
                />

                <div
                    class="alert alert-info d-flex align-items-start"
                    role="alert"
                >
                    <i
                        class="fa fa-info-circle text-info me-2 mt-1"
                        aria-label="Information"
                        title="Information"
                    />

                    <div>
                        <strong>Please confirm before closing this enquiry.</strong>

                        <br/><br/>

                        Where applicable, please confirm that you have:

                        <ul class="mb-0 mt-2">
                            <li>
                                added the sender as a trusted Contact; and
                            </li>
                            <li>
                                manually created the required Helpdesk ticket.
                            </li>
                        </ul>

                        <br/>

                        If no Helpdesk ticket is required, confirm that the
                        enquiry has otherwise been dealt with before closing it.
                    </div>
                </div>

                <footer>

                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm Completed"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>
    </record>

</odoo>