<odoo>
    <record id="adi_helpdesk_review_validity_wizard_view_form" model="ir.ui.view">
        <field name="name">adi.helpdesk.review.validity.wizard.form</field>
        <field name="model">adi.helpdesk.review.validity.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Validity">

                <field name="domain_status" invisible="1"/>
                <field name="domain_status_message" invisible="1"/>
                <field name="adi_company_domain" invisible="1"/>
                <field name="adi_block_domain_allowed" invisible="1"/>

                <div class="mb-3" style="font-size: 18px; font-weight: 600;">
                    Ticket:
                    <field name="ticket_id" readonly="1" class="oe_inline"/>
                </div>

                <group>
                    <field name="contact_email" force_save="1"/>
                    <button name="action_recheck_domain"
                            type="object"
                            string="Recheck Domain"
                            class="btn-secondary"/>                    
                </group>

                <group string="Domain Typo Check">

                    <div class="alert alert-success" colspan="4"
                        invisible="domain_status != 'approved'">
                        <field name="domain_status_message"
                            nolabel="1"
                            readonly="1"/>
                    </div>

                    <div class="alert alert-warning" colspan="4"
                        invisible="domain_status == 'approved'">
                        <field name="domain_status_message"
                            nolabel="1"
                            readonly="1"/>
                    </div>
                </group>

                <div class="alert alert-info mt-3">
                    <strong>What to do next</strong><br/>
                    If the domain is a typo, correct the email address above and click
                    <strong>Move to Contact Review</strong>.<br/>
                    If the domain is not recognised and is not a typo, mark it as spam/block.
                    Genuine new customer domains should be added in the Contacts App and then validated here.
                </div>

                <group string="Spam / Block"
                    invisible="domain_status == 'approved'">
                    <group>
                        <field name="block_email"/>
                        <field name="block_domain"
                            invisible="not adi_block_domain_allowed"/>
                    </group>
                </group>

                <footer>
                    <button name="action_accept"
                            type="object"
                            string="Move to Contact Review"
                            class="btn-primary"
                            invisible="domain_status != 'approved'"/>

                    <button name="action_mark_spam"
                            type="object"
                            string="Mark as Spam"
                            class="btn-secondary"
                            invisible="domain_status == 'approved'"
                            confirm="Are you sure you want to mark this ticket as spam and apply the selected block options?"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>