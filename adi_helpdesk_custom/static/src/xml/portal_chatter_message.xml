<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adi_helpdesk_custom.PortalChatterMessageBody"
       t-inherit="mail.Message"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o-mail-Message-body') and @t-ref='body']"
               position="attributes">

            <attribute name="t-att-class" add="
                'adi_portal_message_body':
                    env.inFrontendPortalChatter
                    and message.adi_is_internal_author
                    and !message.adi_body_already_green
                    and !isEditing
            " separator=","/>

        </xpath>

    </t>

</templates>
