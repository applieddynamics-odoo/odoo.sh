<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adi_helpdesk_custom.PortalChatterMessageBody"
       t-inherit="portal.chatter_messages"
       t-inherit-mode="extension">

        <xpath expr="//t[@t-out='message.body']"
               position="replace">

            <t t-if="message.adi_is_internal_author
                     and !message.adi_body_already_green">
                <div class="adi_portal_message_body">
                    <t t-out="message.body"/>
                </div>
            </t>

            <t t-else="">
                <t t-out="message.body"/>
            </t>

        </xpath>

    </t>

</templates>