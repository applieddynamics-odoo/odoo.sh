<odoo>
  <data>


    <!-- =========================================================
         CI: TREE / SEARCH / FORM
         ========================================================= -->

    <record model="ir.ui.view" id="ci_improvement_tree">
      <field name="name">adi_improvement_app.improvement.tree</field>
      <field name="model">adi_improvement_app.improvement</field>
      <field name="arch" type="xml">
        <tree default_order="action_reference desc">
          <field name="action_reference"/>
          <field name="status"/>
          <field name="process_area"/>
          <field name="title"/>
          <field name="summary"/>
          <field name="owner_id"/>
          <field name="date_due"/>
        </tree>
      </field>
    </record>

    <record id="ci_improvement_search" model="ir.ui.view">
      <field name="name">adi_improvement_app.improvement.search</field>
      <field name="model">adi_improvement_app.improvement</field>
      <field name="arch" type="xml">
        <search string="Continuous Improvements">
          <field name="action_reference"/><field name="title"/><field name="summary"/><field name="owner_id"/><field name="process_area"/><field name="source"/>
          <separator/>
          <filter string="Active" name="active" domain="[('status','!=','closed')]"/>
          <filter string="Closed" name="closed" domain="[('status','=','closed')]"/>
          <separator/>
          <filter string="Open" name="open" domain="[('status','=','open')]"/>
          <filter string="In Progress" name="in_progress" domain="[('status','=','in_progress')]"/>
          <filter string="On Hold" name="on_hold" domain="[('status','=','on_hold')]"/>
          <filter string="Awaiting Verification" name="awaiting_verification" domain="[('status','=','awaiting_verification')]"/>
          <separator/>
          <filter string="Overdue" name="overdue" domain="[('status','!=','closed'),('date_due','&lt;',context_today())]"/>
          <filter string="Type" name="type" domain="[('type','!=',False)]"/>
          <filter string="Submitted" name="submitted_for_verification" domain="[('date_submitted_for_verification','!=',False)]"/>
          <group string="Group By">
            <filter string="Status" name="gb_status" context="{'group_by':'status'}"/>
            <filter string="Type" name="gb_type" context="{'group_by':'type'}"/>
            <filter string="Due Date" name="gb_due" context="{'group_by':'date_due'}"/>
            <filter string="Owner" name="gb_owner" context="{'group_by':'owner_id'}"/>
            <filter string="Process Area" name="gb_process" context="{'group_by':'process_area'}"/>
            <filter string="Source" name="gb_source" context="{'group_by':'source'}"/>
          </group>
        </search>
      </field>
    </record>

    <record model="ir.ui.view" id="ci_improvement_form">
      <field name="name">adi_improvement_app.improvement.form</field>
      <field name="model">adi_improvement_app.improvement</field>
      <field name="arch" type="xml">
        <form string="Continuous Improvement">
          <header>
            <button name="action_set_in_progress"
                    type="object"
                    string="Start"
                    class="btn-primary"
                    invisible="status != 'open'"/>

            <button name="action_set_in_progress"
                    type="object"
                    string="Resume"
                    class="btn-primary"
                    invisible="status != 'on_hold'"/>

            <button name="action_set_on_hold"
                    type="object"
                    string="On Hold"
                    invisible="status not in ('open','in_progress')"/>

            <button name="action_open_closure_wizard"
                    type="object"
                    string="Cancel"
                    class="btn-secondary"
                    invisible="status not in ('open','in_progress','on_hold')"
                    groups="adi_improvement_app.group_ci_admin"/>

            <button name="action_submit_for_verification"
                    type="object"
                    string="Submit"
                    class="btn-primary"
                    invisible="status != 'in_progress'"/>

            <button name="action_open_verification_wizard"
                    type="object"
                    string="Closure Status"
                    class="btn-primary"
                    invisible="status != 'awaiting_verification'"
                    groups="adi_improvement_app.group_ci_admin"/>

            <button name="action_reopen"
                    type="object"
                    string="Reopen"
                    invisible="status != 'closed'"/>

            <field name="status"
                   widget="statusbar"
                   options="{'clickable': true}"
                   statusbar_visible="open,in_progress,on_hold,awaiting_verification,closed"/>
          </header>

          <sheet>
            <div class="oe_title">
              <h1><field name="action_reference" readonly="1"/></h1>
            </div>

            <group>

              <!--CI Improvement Main Left section-->
              <group>
                <field name="title" placeholder="Short title (e.g. CAR Report improvement )"/>
                <field name="date_opened_display" string="Date Opened" readonly="1" invisible="not action_reference"/>
                <field name="process_area"/>
                <field name="source"/>
              </group>

              <!--CI Improvement Main Right section-->
              <group>
                <field name="owner_id"/>
                <field name="type"/>
                <field name="date_in_progress" readonly="1" invisible="date_in_progress == False"/>
                <field name="date_due"/>
                <field name="ci_date_done" readonly="1" string="Close Date" invisible="status != 'closed'"/>
              </group>
            </group>

              <!--CI Improvement Details section--> 

            <div style="border: 1px solid #adb5bd; border-radius: 4px; padding: 10px 14px 14px 14px; margin-bottom: 14px;">

                <div style="font-weight:700; padding-bottom:8px; margin-bottom:10px; border-bottom:1px solid #adb5bd; color:#343a40;">
                    IMPROVEMENT DETAILS
                </div>

                <div class="mb-3">
                    <div class="o_form_label">
                        <strong>Description / Opportunity</strong>
                        <span style="color:#6c757d; font-weight:400;">
                            — What is the improvement? What is the current situation and what could be better?
                        </span>
                    </div>
                    <field name="summary" nolabel="1"/>
                </div>

                <div class="mb-3">
                    <div class="o_form_label">
                        <strong>Justification / Benefit</strong>
                        <span style="color:#6c757d; font-weight:400;">
                            — Why are we doing this? (e.g. efficiency, cost saving, risk reduction, customer satisfaction)
                        </span>
                    </div>
                    <field name="notes" nolabel="1"/>
                </div>

                <div class="mb-3">
                    <div class="o_form_label">
                        <strong>Actions / Implementation Plan</strong>
                        <span style="color:#6c757d; font-weight:400;">
                            — Key steps required to implement the improvement.
                        </span>
                    </div>
                    <field name="actions" nolabel="1"/>
                </div>

                <div class="mb-0">
                    <div class="o_form_label">
                        <strong>Progress Updates / Notes</strong>
                        <span style="color:#6c757d; font-weight:400;">
                            — Ongoing updates, decisions, blockers
                        </span>
                    </div>
                    <field name="progress_updates" nolabel="1"/>
                </div>

            </div>


            <!--CI Verification and Closure section--> 
            <div style="border: 1px solid #adb5bd; border-radius: 4px; padding: 10px 14px 14px 14px; margin-bottom: 14px;"
                invisible="status not in ('awaiting_verification', 'closed')">

              <div style="font-weight:700; padding-bottom:8px; margin-bottom:10px; border-bottom:1px solid #adb5bd; color:#343a40;">
                  VERIFICATION / CLOSURE
              </div>
              <group col="2">
                  <field name="date_submitted_for_verification"
                        string="Submitted"
                        readonly="1"
                        invisible="date_submitted_for_verification == False"/>
                  <field name="verification_result" readonly="1"/>
                  <field name="verified_by" readonly="1"/>
                  <label for="ci_date_done" string="Closed" invisible="ci_date_done == False"/>
                  <field name="ci_date_done" nolabel="1" readonly="1" invisible="ci_date_done == False"/>

                  <field name="closure_statement"
                        widget="text"
                        readonly="1"
                        placeholder="Closure statement and verification outcome..."/>
              </group>
            </div>

          </sheet>

          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>


    <!-- =========================================================
         CI WIZARD
         ========================================================= -->

    <record id="view_ci_verification_wizard_form" model="ir.ui.view">
      <field name="name">adi_improvement_app.ci.verification.wizard.form</field>
      <field name="model">adi_improvement_app.ci_verification_wizard</field>
      <field name="arch" type="xml">
        <form string="CI Closure Status">
          <sheet>
            <div style="margin-bottom:12px; color:#495057;">
              Record the closure result providing guidance if additional work is required or a succinct statement recording the effectiveness of the improvement 
            </div>

            <group col="1">
              <field name="verification_result"/>
              <field name="closure_statement"
                     widget="text"
                     placeholder="Enter closure statement / verification notes..."/>
            </group>
          </sheet>

          <footer>
            <button name="action_confirm"
                    type="object"
                    string="Confirm"
                    class="btn-primary"/>
            <button string="Cancel"
                    special="cancel"
                    class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>


    <!-- =========================================================
         CAR: TREE / SEARCH / FORM
         ========================================================= -->

    <record model="ir.ui.view" id="car_tree">
      <field name="name">adi_improvement_app.car.tree</field>
      <field name="model">adi_improvement_app.car</field>
      <field name="arch" type="xml">
        <tree default_order="action_reference desc">
          <field name="action_reference"/>
          <field name="status"/>
          <field name="process_area"/>
          <field name="title"/>
          <field name="owner_id"/>
          <field name="risk"/>
          <field name="target_contained_date"/>
          <field name="related_so"/>
          <field name="verification_counter"/>
        </tree>
      </field>
    </record>

    <record id="car_search" model="ir.ui.view">
      <field name="name">adi_improvement_app.car.search</field>
      <field name="model">adi_improvement_app.car</field>
      <field name="arch" type="xml">
        <search string="Corrective Actions (CAR)">
          <field name="action_reference"/>
          <field name="title"/>
          <field name="summary"/>
          <field name="owner_id"/>
          <field name="process_area"/>
          <field name="source"/>

          <separator/>

          <filter string="Active" name="active" domain="[('status','!=','closed')]"/>
          <filter string="Closed" name="closed" domain="[('status','=','closed')]"/>

          <separator/>

          <filter string="Open" name="open" domain="[('status','=','open')]"/>
          <filter string="Containment" name="containment" domain="[('status','=','containment')]"/>
          <filter string="Awaiting Verification" name="awaiting_verification" domain="[('status','=','awaiting_verification')]"/>

          <separator/>

          <filter string="Overdue" name="overdue" domain="[('status','!=','closed'),('target_contained_date','&lt;',context_today())]"/>
          <filter string="Verification Failed" name="verification_failed" domain="[('verification_counter','&gt;',0)]"/>
          <filter string="High Risk" name="high_risk" domain="[('risk','=','high')]"/>
          <filter string="Related SO" name="related_so" domain="[('related_so_applicable','=','yes')]"/>
          <filter string="Repeat Occurrence" name="repeat_occurrence" domain="[('occurrence','=','repeat')]"/>

          <group string="Group By">
            <filter string="Status" name="gb_status" context="{'group_by':'status'}"/>
            <filter string="Risk" name="gb_risk" context="{'group_by':'risk'}"/>
            <filter string="Due Date" name="gb_due" context="{'group_by':'target_contained_date'}"/>
            <filter string="Owner" name="gb_owner" context="{'group_by':'owner_id'}"/>
            <filter string="Process Area" name="gb_process" context="{'group_by':'process_area'}"/>
            <filter string="Source" name="gb_source" context="{'group_by':'source'}"/>
            <filter string="Customer" name="gb_customer" context="{'group_by':'customer_company_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="car_form" model="ir.ui.view">
      <field name="name">adi_improvement_app.car.form</field>
      <field name="model">adi_improvement_app.car</field>
      <field name="arch" type="xml">
        <form string="Corrective Action Report (CAR)">
          <header>
            <!-- Primary buttons and status bar -->
            <button name="action_start_containment"
                    type="object"
                    string="Start Containment"
                    class="btn-primary"
                    invisible="status != 'open'"/>
            <button name="action_open_verification_wizard"
                    type="object"
                    string="Containment Done"
                    class="btn-primary"
                    invisible="status != 'containment'"/>
            <button name="action_open_close_wizard"
                    type="object"
                    string="Verification Review"
                    class="btn-primary"
                    invisible="status != 'awaiting_verification'"
                    groups="adi_improvement_app.group_car_admin"/>
            <button name="action_reopen"
                    type="object"
                    string="Reopen"
                    invisible="status != 'closed'"
                    groups="adi_improvement_app.group_car_admin"/>
            <field name="status"
                   widget="statusbar"
                   options="{'clickable': true}"
                   statusbar_visible="open,containment,awaiting_verification,closed"/>
          </header>

          <sheet>
            <!--CAR Number Header  -->
            <div class="oe_title">
              <h1>
                <field name="action_reference" readonly="1"/>
              </h1>
            </div>

            <!--CAR Main form Left hand group  -->
            <group col="2">
              <group>
                <field name="title" placeholder="Short title (e.g. Supplier NCR on parts batch)"/>
                <field name="date_opened_display" string="Date Opened" readonly="1" invisible="not action_reference"/>
                <field name="source"/>
                <field name="related_so_applicable"
                       string="Related Sales Order?"
                       widget="radio"
                       options="{'horizontal': true}"/>
                <field name="related_so"
                       string="Related SO"
                       placeholder="Select Sales Order"
                       invisible="related_so_applicable != 'yes'"/>
                <field name="customer_company_id" invisible="1" readonly="1"/>
                <field name="related_so_description" invisible="1" readonly="1"/>
              </group>

                <!--CAR Main form Right hand group  -->
              <group>
                <field name="process_area"/>
                <field name="owner_id"/>
                <field name="occurrence" widget="radio" options="{'horizontal': true}"/>
                <field name="risk"
                       widget="radio"
                       options="{'horizontal': true}"
                       readonly="status in ('awaiting_verification', 'closed')"/>
                <field name="target_contained_date" string="Target date" readonly="1" invisible="1"/>
              </group>
            </group>

            <!-- CAR Containment Block -->
            <div style="border: 1px solid #adb5bd; border-radius: 4px; padding: 10px 14px 14px 14px; margin-bottom: 14px;"
                 invisible="status == 'open'">

              <div style="display:flex; align-items:center; gap:24px; min-width:0; padding-bottom:8px; margin-bottom:10px; border-bottom:1px solid #adb5bd; color:#495057;">

                <div style="font-weight:700; min-width:260px; color:#343a40;">
                  CONTAINMENT STAGE:
                </div>

                <div style="font-weight:400; white-space:nowrap;">
                  <field name="target_contained_date_display" nolabel="1" readonly="1"/>
                </div>

                <div invisible="verification_counter == 0"
                     style="width:100%; text-align:center; margin-bottom:4px;">

                  <span style="display:inline-block;
                               font-size:12px;
                               font-weight:600;
                               color:#dc3545;
                               background:#fff5f5;
                               border:1px solid #e85b69;
                               border-radius:10px;
                               padding:2px 8px;">
                    Verification fails:
                    <field name="verification_counter"
                           nolabel="1"
                           readonly="1"
                           style="display:inline-block; margin-left:2px; color:#dc3545; font-weight:700;"/>
                  </span>
                </div>

              </div>

              <group col="2">
                <field name="summary"
                       string="Description"
                       widget="text"
                       placeholder="Short description of the issue / nonconformity..."/>

                <field name="containment"
                       widget="text"
                       placeholder="Immediate containment actions taken, dates, evidence..."/>

                <field name="cause"
                       widget="text"
                       string="Root Cause"
                       placeholder="Root cause analysis (5-Whys, fishbone, etc.)..."/>

                <field name="car_actions"
                       widget="text"
                       string="Corrective Actions"
                       placeholder="Corrective actions, owners, target dates, evidence..."/>

                <label for="car_date_done" string="Contained" invisible="car_date_done == False"/>
                <field name="car_date_done" nolabel="1" invisible="car_date_done == False"/>
              </group>
            </div>

            <!--CAR Verification Block -->
            <div style="border: 1px solid #adb5bd; padding: 10px 14px 14px 14px; border-radius: 4px; margin-bottom: 14px;"
                 invisible="status not in ('awaiting_verification', 'closed') and verification_counter == 0">

              <div style="display:flex; align-items:center; justify-content:space-between; padding-bottom:8px; margin-bottom:10px; border-bottom:1px solid #adb5bd; color:#495057;">

                <div style="display:flex; align-items:center; gap:24px;">
                  <div style="font-weight:700; min-width:260px; color:#343a40;">
                    VERIFICATION STAGE:
                  </div>

                  <div style="font-weight:400; color:#495057;">
                    <field name="est_verify_end_date_display" readonly="1" nolabel="1"/>
                  </div>
                </div>

              </div>

              <group col="2">
                <field name="verification_notes"
                       widget="text"
                       string="Verification Evidence"
                       placeholder="Verification objective evidence and review notes..."/>
                <field name="est_verify_end_date" label="Estimated date"/>
                <field name="verified_by"/>
              </group>
            </div>

          </sheet>
          <!--CAR Chatter Section -->
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>

    <!-- =========================================================
         ACTIONS + MENUS
         ========================================================= -->

    <record id="action_ci_improvements" model="ir.actions.act_window">
      <field name="name">Continuous Improvements</field>
      <field name="res_model">adi_improvement_app.improvement</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="ci_improvement_search"/>
      <field name="context"> {'search_default_active': 1,'search_default_group_by_status': 1} </field>
    </record>

    <record id="action_cars" model="ir.actions.act_window">
      <field name="name">Corrective Actions (CAR)</field>
      <field name="res_model">adi_improvement_app.car</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="car_search"/>
      <field name="context"> {'search_default_active': 1,'search_default_group_by_status': 1} </field>
    </record>

    <!-- ROOT APP TILE -->
    <menuitem id="menu_adi_improvement_root"
              name="Improvements"
              sequence="5"
              action="action_ci_improvements"
              web_icon="adi_improvement_app,static/description/icon.png"
              groups="base.group_user"/>

    <!-- FIRST MENU -->
    <menuitem id="menu_ci_improvements"
              name="Continuous Improvements"
              parent="menu_adi_improvement_root"
              action="action_ci_improvements"
              sequence="10"
              groups="base.group_user"/>

    <!-- SECOND MENU -->
    <menuitem id="menu_car"
              name="Corrective Actions (CAR)"
              parent="menu_adi_improvement_root"
              action="action_cars"
              sequence="20"
              groups="base.group_user"/>
  </data>
</odoo>