<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_roles_responsibility_tree" model="ir.ui.view">
            <field name="name">adi_improvement_app.roles.responsibility.tree</field>
            <field name="model">adi_improvement_app.roles_responsibility</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_roles_responsibility_form" model="ir.ui.view">
            <field name="name">adi_improvement_app.roles.responsibility.form</field>
            <field name="model">adi_improvement_app.roles_responsibility</field>
            <field name="arch" type="xml">
                <form string="Roles and Responsibilities">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>

                        <group string="Quality Lead Assignment Order">
                            <field name="quality_lead_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="user_id"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_roles_responsibility" model="ir.actions.act_window">
            <field name="name">Roles and Responsibilities</field>
            <field name="res_model">adi_improvement_app.roles_responsibility</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_roles_responsibility"
            name="Roles and Responsibilities"
            parent="adi_improvement_app.menu_adi_improvement_root"
            action="action_roles_responsibility"
            sequence="90"
            groups="base.group_system"/>

    </data>
</odoo>