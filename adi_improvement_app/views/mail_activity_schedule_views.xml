<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="adi_verification_activity_schedule_view" model="ir.ui.view">
        <field name="name">mail.activity.schedule.verification</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">

            <!-- Hide Schedule & Mark as Done -->
            <xpath expr="//button[@name='action_schedule_activities_done']" position="attributes">
                <attribute name="invisible">context.get('adi_verification_flow')</attribute>
            </xpath>

            <!-- Hide Done & Schedule Next / Launch Next -->
            <xpath expr="//button[@name='action_schedule_activities_done_and_schedule']" position="attributes">
                <attribute name="invisible">context.get('adi_verification_flow')</attribute>
            </xpath>

        </field>
    </record>


</odoo>