<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mail.Activity" t-inherit-mode="extension">

        <!-- Prevent manual completion of workflow activities -->
        <xpath expr="//button[contains(@class, 'o-mail-Activity-markDone')]" position="attributes">
            <attribute name="t-if">!props.activity.summary || !props.activity.summary.includes('[WORKFLOW]')</attribute>
        </xpath>

        <!-- Prevent editing workflow activities -->
        <xpath expr="//button[contains(@class, 'o-mail-Activity-edit')]" position="attributes">
            <attribute name="t-if">!props.activity.summary || !props.activity.summary.includes('[WORKFLOW]')</attribute>
        </xpath>

        <!-- Prevent cancellation of workflow activities -->
        <xpath expr="//button[@t-on-click='unlink']" position="attributes">
            <attribute name="t-if">!props.activity.summary || !props.activity.summary.includes('[WORKFLOW]')</attribute>
        </xpath>

    </t>
</templates>
